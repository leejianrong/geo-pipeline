# Torch-free detector: ONNX Runtime only (ADR-0014). Same model names as the default image.
# The export stage needs torch once, to write the RF-DETR ONNX files; the final image has none.
FROM python:3.12-slim-trixie AS export
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir "rfdetr[onnx]"
COPY scripts/export_rfdetr_onnx.py /export.py
RUN python /export.py --variant Small --out /models && python /export.py --variant Nano --out /models

FROM python:3.12-slim-trixie
RUN pip install --no-cache-dir onnxruntime
COPY --from=export /models/rfdetr-small.onnx /models/rfdetr-nano.onnx /models/
ADD --checksum=sha256:c5c2d13e59ae883e6af3b45daea64af4833a4951c92d116ec270d9ddbe998063 \
    https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_s.onnx /models/yolox_s.onnx
ADD --checksum=sha256:427cc366d34e27ff7a03e2899b5e3671425c262ea2291f88bb942bc1cc70b0f7 \
    https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_tiny.onnx /models/yolox_tiny.onnx
COPY libs/geopipe /src/geopipe
RUN pip install --no-cache-dir /src/geopipe
COPY stages/detector/backends.py stages/detector/yolox_onnx.py stages/detector/rfdetr_onnx.py \
     stages/detector/main.py /app/
ENV DETECTOR_RUNTIME=onnx
CMD ["python", "/app/main.py"]
